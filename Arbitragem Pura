class DataLoader:
    """Classe responsável por carregar e processar os dados de spread."""
    
    def __init__(self, base_folder: str):
        """Inicializa o carregador de dados."""
        self.spread_file_path = os.path.join(base_folder, "dados_com_spread.csv")
        
    def load_and_process(self) -> pd.DataFrame:
        """Carrega e processa os dados."""
        try:
            if not os.path.exists(self.spread_file_path):
                raise FileNotFoundError(f"Arquivo não encontrado: {self.spread_file_path}")
            
            logger.info(f"📂 Carregando arquivo: {self.spread_file_path}")
            df_spread = pd.read_csv(self.spread_file_path, parse_dates=["Timestamp"])
            
            # Verificar se colunas necessárias existem
            required_columns = ['Timestamp', 'close_x', 'close_y', 'spread', 'transation_cost', 'businessday']
            for col in required_columns:
                if col not in df_spread.columns:
                    raise ValueError(f"Coluna '{col}' não encontrada no CSV de spread!")
            
            # Processamento do spread
            df_spread.set_index('Timestamp', inplace=True)
            df_spread.sort_index(inplace=True)
            
            # Inicializar colunas financeiras
            df_spread["cash"] = 100000.0
            df_spread["portfolio_value"] = 100000.0
            
            logger.info(f"✅ Dados carregados: {len(df_spread)} registros de {df_spread.index.min()} a {df_spread.index.max()}")
            return df_spread

        except Exception as e:
            logger.error(f"❌ Erro ao carregar dados: {e}")
            return pd.DataFrame()


class ArbitrageBacktest:
    """Classe para backtest de arbitragem entre PAXG e XAUUSD."""
    
    def __init__(self, df, initial_capital=100000.0, allocation_fraction=0.20):
        """
        Inicializa o backtest de arbitragem.
        
        Args:
            df: DataFrame com dados de preço e spread
            initial_capital: Capital inicial para o backtest
            allocation_fraction: Fração do capital a ser alocada em cada oportunidade
        """
        self.df = df.copy()
        self.initial_capital = initial_capital
        self.allocation_fraction = allocation_fraction
        self.trades = []
        self.total_trades = 0
        self.profitable_trades = 0
    
    def run_backtest(self):
        """Executa o backtest da estratégia de arbitragem pura."""
        if self.df.empty:
            logger.warning("DataFrame vazio. Não há dados para backtest.")
            return
        
        logger.info(f"Iniciando backtest com {len(self.df)} períodos...")
        
        # Inicializando colunas de resultado
        self.df["cash"] = self.initial_capital
        self.df["portfolio_value"] = self.initial_capital
        self.df["trade_signal"] = 0
        self.df["trade_profit"] = 0.0
        self.df["daily_return"] = 0.0
        self.df["allocation"] = 0.0  # Registra quanto do portfólio foi alocado em cada trade
        self.df["potential_profit"] = 0.0  # Lucro teórico da arbitragem (para análise)
        self.df["spread_pct"] = (self.df["spread"] - 1) * 100  # Spread como percentual
        
        # Executando o backtest período a período
        for i in range(1, len(self.df)):
            idx_prev, idx_curr = self.df.index[i-1], self.df.index[i]
            
            # Obtém valores do período atual
            row = self.df.loc[idx_curr]
            price_paxg = row["close_x"]
            price_xauusd = row["close_y"]
            spread = row["spread"]
            transaction_cost = row["transation_cost"]
            business_day = row["businessday"]
            
            # Obtém valores do período anterior
            cash_prev = self.df.at[idx_prev, "cash"]
            
            # Atualiza cash (sem juros para simplificar)
            cash_new = cash_prev
            
            # Calcula o lucro teórico por unidade para este spread (análise)
            potential_profit_pct = spread - 1 - transaction_cost / price_paxg
            self.df.at[idx_curr, "potential_profit"] = potential_profit_pct * 100  # Em percentual
            
            # Verifica oportunidade de arbitragem:
            # 1. Se XAUUSD está mais caro que PAXG (spread > 1)
            # 2. E se a diferença é maior que o custo de transação
            # 3. E estamos em um dia útil (businessday = 1)
            if spread > (1 + transaction_cost/price_paxg) and business_day == 1:
                # Calcula o valor a ser investido - usa uma fração do capital
                invest_amount = cash_new * self.allocation_fraction
                
                if invest_amount > 0:
                    # Calcula a quantidade a ser negociada
                    quantity = invest_amount / price_paxg
                    
                    # Operação completa de arbitragem
                    paxg_cost = quantity * price_paxg
                    xauusd_revenue = quantity * price_xauusd
                    
                    # Lucro líquido considerando o custo de transação
                    profit = xauusd_revenue - paxg_cost - transaction_cost
                    
                    if profit > 0:
                        # Calcula percentual de alocação do portfólio
                        allocation_pct = (paxg_cost / cash_new) * 100
                        
                        # Atualiza cash
                        cash_new = cash_new - paxg_cost + xauusd_revenue - transaction_cost
                        
                        # Registra trade
                        self.trades.append({
                            "timestamp": idx_curr,
                            "price_paxg": price_paxg,
                            "price_xauusd": price_xauusd,
                            "quantidade": quantity,
                            "spread": spread,
                            "spread_pct": (spread - 1) * 100,  # Spread em %
                            "profit": profit,
                            "profit_pct": (profit / paxg_cost) * 100,  # Lucro em %
                            "allocation": allocation_pct,  # % do portfólio alocado
                            "transaction_cost": transaction_cost
                        })
                        
                        # Atualiza métricas
                        self.total_trades += 1
                        self.profitable_trades += 1
                        
                        # Sinaliza trade
                        self.df.at[idx_curr, "trade_signal"] = 1
                        self.df.at[idx_curr, "trade_profit"] = profit
                        self.df.at[idx_curr, "allocation"] = allocation_pct
            
            # Atualiza o valor do portfólio
            self.df.at[idx_curr, "cash"] = cash_new
            self.df.at[idx_curr, "portfolio_value"] = cash_new
            
            # Calcula o retorno diário
            self.df.at[idx_curr, "daily_return"] = (cash_new / self.df.at[idx_prev, "portfolio_value"]) - 1
        
        # Calcula o retorno acumulado
        self.df["cumulative_return"] = (1 + self.df["daily_return"]).cumprod() - 1
        
        # Calcula retorno total e outras métricas
        final_value = self.df["portfolio_value"].iloc[-1]
        total_return = (final_value / self.initial_capital - 1) * 100
        logger.info(f"✅ Backtest concluído: {self.total_trades} trades, {total_return:.2f}% retorno total")
    
