    def get_metrics(self):
        """Retorna métricas simplificadas de desempenho."""
        if self.df.empty:
            return {"error": "Sem dados para análise"}
        
        # Métricas básicas
        final_value = self.df["portfolio_value"].iloc[-1]
        total_return = (final_value / self.initial_capital - 1) * 100
        
        # Métricas de trade
        avg_profit = self.df[self.df["trade_profit"] > 0]["trade_profit"].mean()
        total_profit = self.df["trade_profit"].sum()
        
        # Métricas de alocação
        avg_allocation = self.df[self.df["allocation"] > 0]["allocation"].mean()
        max_allocation = self.df["allocation"].max()
        
        # Métricas de spread
        avg_trade_spread = 0
        if self.total_trades > 0:
            avg_trade_spread = np.mean([t["spread_pct"] for t in self.trades])
        
        # Métricas de oportunidade
        total_days = len(self.df)
        days_with_trades = len(self.df[self.df["trade_signal"] == 1])
        opportunity_rate = (days_with_trades / total_days) * 100
        
        # Período analisado
        start_date = self.df.index.min().strftime('%d/%m/%Y')
        end_date = self.df.index.max().strftime('%d/%m/%Y')
        
        return {
            "Capital Inicial": f"${self.initial_capital:,.2f}",
            "Capital Final": f"${final_value:,.2f}",
            "Retorno Total": f"{total_return:.2f}%",
            "Número de Operações": self.total_trades,
            "Taxa de Sucesso": "100%" if self.total_trades > 0 else "N/A",
            "Lucro Total": f"${total_profit:,.2f}",
            "Lucro Médio por Operação": f"${avg_profit:,.2f}" if self.total_trades > 0 else "N/A",
            "Spread Médio nas Operações": f"{avg_trade_spread:.4f}%" if self.total_trades > 0 else "N/A",
            "Alocação Média por Trade": f"{avg_allocation:.2f}%" if self.total_trades > 0 else "N/A",
            "Alocação Máxima": f"{max_allocation:.2f}%" if self.total_trades > 0 else "N/A",
            "Taxa de Oportunidade": f"{opportunity_rate:.2f}%",
            "Período Analisado": f"{start_date} a {end_date}"
        }


